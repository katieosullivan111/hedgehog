#lang racket
(provide (struct-out pos) (struct-out gs) mega lane vroom-vroom cars  m2p p2m)

(struct pos (x y)) ; Position Structure
(struct gs (camera player velocity accelerator lives BOOST EXTRALIFE cars) #:mutable) ; Game State
(define (m2p m) (* m 20)) ; meters to pixels
(define (p2m p) (/ p 20)) ; pixels to meters

(define lw (random 150)) ; lane width

(define lane
  (list (pos (+ lw 150) 300)
       (pos (+ lw 350) 300)
       (pos (+ lw 500) 300)
       (pos (+ lw 650) 300)))

(define (rand x)
  (+ x (random 500)))

(define (gap game)
  (cond
    [(< (pos-y (gs-player game)) 50) 75]
    [(and (> (pos-y (gs-player game)) 50) (< (pos-y (gs-velocity game)) 100) 125)]
    [(and (> (pos-y (gs-player game)) 100) (< (pos-y (gs-velocity game)) 150) 150)]
    [(> (pos-y (gs-player game)) 150) 200]))

(define (randposns n)
      (if (<= n 20)
          (cons (random 4) (randposns (+ n 1)))
          empty))




      ;Creates a list of random cars
(define (sum n a b c d game)
  (if (<= n 20)
      (local [(define e (* a 150)) (define f (* b 150)) (define g (* c 150)) (define h (* d 150)) (define x 0)]
          (cons
      (cond
        [(= x 0) (pos (pos-x (first (gs-cars game))) (- (pos-y (first (gs-cars game))) (rand e)))]
        [(= x 1) (pos (pos-x (second (gs-cars game))) (- (pos-y (second (gs-cars game))) (rand f)))]
        [(= x 2) (pos (pos-x (third (gs-cars game))) (- (pos-y (third (gs-cars game))) (rand g)))]
        [else (pos (pos-x (fourth (gs-cars game))) (- (pos-y (fourth (gs-cars game))) (rand h)))])
        (cond
        [(= x 0) (sum (+ n 1) (+ a 1) b c d game)]
        [(= x 1) (sum (+ n 1) a (+ b 1) d game)]
        [(= x 2) (sum (+ n 1) a b (+ c 1) d game)]
        [else (sum (+ n 1) a b c (+ d 1) game)])))
      empty))


;Creates 51 random cars
(define (mega game)
  (sum 0 0 0 0 0 game))

;Converts the cars to pos
(define (cars x game)
  (if (empty? x)
      empty
      (cons (pos (- (pos-x (first x)) (pos-x (gs-camera game))) (- (pos-y (first x))
                                                                             (pos-y (gs-camera game))))
            (cars (rest x) game))))

 

;Allows us to take out some elements
(define (list-maker-cars x game)
  (take (cars (mega game) game) x))


;Sets the gs to that list of pos for draw game
(define (vroom-vroom game)
  (cond
    [(> (pos-y (gs-player game)) -1000) (list-maker-cars 5 game)]
    [(and (<= (pos-y (gs-player game)) -1000) (> (pos-y (gs-player game)) -2000)) (list-maker-cars 10 game)]
    [(and (<= (pos-y (gs-player game)) -2000) (> (pos-y (gs-player game)) -3000)) (list-maker-cars 15 game)]
    [else (list-maker-cars 20 game)]))
 